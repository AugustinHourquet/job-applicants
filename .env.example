# Copy to .env and fill in. .env is gitignored — never commit your key.
#
# Get a token at https://www.kaggle.com/settings -> API -> "Create New Token".
# That downloads kaggle.json; copy the two values out of it.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Change if 8501 is already taken on your machine.
APP_PORT=8501
