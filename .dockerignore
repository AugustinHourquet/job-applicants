# Build context hygiene: keep the image small and the cache stable.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Data and outputs are bind-mounted at runtime, never baked into the image.
data/
artifacts/
slides/
ext-resources/

# Local-only
.env
.DS_Store
docs/
*.md
!README.md
